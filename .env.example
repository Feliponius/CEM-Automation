# Gmail credentials for fetch_samples.py
# 1. Use the Gmail address where CEM reports arrive
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
#    (requires 2-Step Verification to be enabled)

GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Web App API (for query_sheet.py)
# After deploying the Apps Script as a web app, paste the URL and secret here.
# The secret must match the WEB_APP_SECRET value in your config_runtime sheet.

WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
WEB_APP_SECRET=your-secret-here
WEB_APP_DEPLOYMENT_ID=YOUR_DEPLOYMENT_ID
